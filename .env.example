# ==============================================================================
# NOTEBOOK: Environment Configuration Template
# ==============================================================================

# 1. SUPABASE CLOUD CONFIGURATION (Free Tier)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Service role key for trusted server-side admin tasks only (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. SUPABASE POSTGRESQL DATABASE
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI, Connection Pooling enabled, port 6543)
# Example: postgresql://postgres.[project-id]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# 3. GOOGLE OAUTH CONFIGURATION (Via Supabase Auth)
# Configured in: Supabase Dashboard -> Authentication -> Providers -> Google
# Client ID and Client Secret generated in: Google Cloud Console -> APIs & Services -> Credentials
# Also optional if using Google Identity Services (GIS) directly:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. APPLICATION URLS
# Local development: http://localhost:3000
# Production on Vercel: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. LOCAL DEVELOPMENT FALLBACK
# Set to 'true' to allow local-only testing without Supabase credentials. Set to 'false' in production.
NEXT_PUBLIC_ENABLE_LOCAL_AUTH=false

# 6. OPTIONAL HOCUSPOCUS WEBSOCKET COLLABORATION
# Leave empty to use Supabase Realtime for collaboration.
# If running standalone Hocuspocus: ws://localhost:1234
NEXT_PUBLIC_WS_URL=
